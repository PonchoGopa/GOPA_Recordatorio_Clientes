        "jsCode": "// Protección antiduplicados:\n// Si ya se envió un recordatorio HOY para esta obligación, se descarta\nreturn items.filter(item => {\n  const ultima = item.json.ultima_fecha_envio || '';\n  const hoy = item.json.hoy_str;\n  return ultima !== hoy;\n});"
