    {
      "parameters": {
        "jsCode": "// Agrupa toda la lista para generar el reporte semanal del contador\nconst hoy = new Date();\nhoy.setHours(0, 0, 0, 0);\n\nconst urgentes = [];\nconst proximos = [];\nconst pendientes = [];\n\nfor (const item of items) {\n  const fechaVenc = new Date(item.json.fecha_vencimiento);\n  fechaVenc.setHours(0, 0, 0, 0);\n  const dias = Math.round((fechaVenc - hoy) / (1000 * 60 * 60 * 24));\n\n  if (dias < 0) {\n    pendientes.push({ ...item.json, dias });\n  } else if (dias <= 3) {\n    urgentes.push({ ...item.json, dias });\n  } else if (dias <= 10) {\n    proximos.push({ ...item.json, dias });\n  }\n}\n\nconst lineasUrgentes = urgentes.map(c =>\n  `  • ${c.cliente_nombre} — ${c.obligacion} — ${c.dias === 0 ? 'HOY' : `${c.dias} día(s)`}`\n).join('\\n') || '  (ninguno)';\n\nconst lineasProximos = proximos.map(c =>\n  `  • ${c.cliente_nombre} — ${c.obligacion} — ${c.dias} día(s)`\n).join('\\n') || '  (ninguno)';\n\nconst lineasVencidos = pendientes.map(c =>\n  `  • ${c.cliente_nombre} — ${c.obligacion} — vencido hace ${Math.abs(c.dias)} día(s)`\n).join('\\n') || '  (ninguno)';\n\nconst fechaStr = hoy.toLocaleDateString('es-MX', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });\n\nconst reporte = `REPORTE SEMANAL DE OBLIGACIONES FISCALES\n${fechaStr}\n${'='.repeat(45)}\n\n🔴 URGENTES (0–3 días):\n${lineasUrgentes}\n\n📅 PRÓXIMOS (4–10 días):\n${lineasProximos}\n\n⚠️ POSIBLES VENCIDOS (revisar):\n${lineasVencidos}\n\nTotal clientes monitoreados: ${items.length}\nGenerado automáticamente por tu sistema de recordatorios.`;\n\nreturn [{ json: { reporte, total: items.length, urgentes: urgentes.length, proximos: proximos.length } }];"
      },
