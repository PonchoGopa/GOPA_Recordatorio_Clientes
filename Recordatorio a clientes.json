    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const dias = item.json.dias_restantes;\n  const nombre = item.json.cliente_nombre;\n  const obligacion = item.json.obligacion;\n  const periodo = item.json.periodo;\n  const fecha = item.json.fecha_vencimiento;\n\n  let asunto, emailMsg, waMsg;\n\n  if (dias === 7) {\n    asunto = `Recordatorio: ${obligacion} vence en 7 días`;\n    emailMsg = `Estimado equipo de ${nombre},\\n\\nLe recordamos que su obligación fiscal vence en 7 días.\\n\\nObligación: ${obligacion}\\nPeríodo: ${periodo}\\nFecha límite: ${fecha}\\n\\nEste es un recordatorio preventivo para reunir la documentación con tiempo.\\n\\nQuedamos a sus órdenes.`;\n    waMsg = `📅 *Recordatorio fiscal — 7 días*\\n\\nHola equipo de *${nombre}*,\\n\\nLes recordamos que la siguiente obligación vence en 7 días:\\n\\n• *Obligación:* ${obligacion}\\n• *Período:* ${periodo}\\n• *Fecha límite:* ${fecha}\\n\\nTiempo suficiente para preparar la documentación con calma. 💼\\n\\n_Despacho Contable_`;\n\n  } else if (dias === 3) {\n    asunto = `⚠️ Urgente: ${obligacion} vence en 3 días`;\n    emailMsg = `Estimado equipo de ${nombre},\\n\\nLe recordamos que su obligación fiscal vence en 3 días.\\n\\nObligación: ${obligacion}\\nPeríodo: ${periodo}\\nFecha límite: ${fecha}\\n\\nPor favor asegúrese de contar con toda la información necesaria.\\n\\nQuedamos a sus órdenes.`;\n    waMsg = `⚠️ *URGENTE — 3 días para vencimiento*\\n\\nHola equipo de *${nombre}*,\\n\\n• *Obligación:* ${obligacion}\\n• *Período:* ${periodo}\\n• *Fecha límite:* ${fecha}\\n\\nPor favor confirmen que ya tienen lista la documentación para poder presentar a tiempo. 🙏\\n\\n_Despacho Contable_`;\n\n  } else if (dias === 1) {\n    asunto = `🔔 Mañana vence: ${obligacion}`;\n    emailMsg = `Estimado equipo de ${nombre},\\n\\nMañana vence la siguiente obligación fiscal.\\n\\nObligación: ${obligacion}\\nPeríodo: ${periodo}\\nFecha límite: ${fecha}\\n\\nSi aún no han enviado la documentación, es necesario hacerlo hoy.\\n\\nQuedamos a sus órdenes.`;\n    waMsg = `🔔 *¡Vence MAÑANA!*\\n\\nHola equipo de *${nombre}*,\\n\\n• *Obligación:* ${obligacion}\\n• *Período:* ${periodo}\\n• *Fecha límite:* ${fecha}\\n\\nSi falta documentación, envíenla hoy a más tardar para presentar sin recargos. 🚨\\n\\n_Despacho Contable_`;\n\n  } else if (dias === 0) {\n    asunto = `🔴 HOY VENCE: ${obligacion}`;\n    emailMsg = `Estimado equipo de ${nombre},\\n\\nHOY VENCE la siguiente obligación fiscal.\\n\\nObligación: ${obligacion}\\nPeríodo: ${periodo}\\nFecha límite: ${fecha}\\n\\nSi aún no ha presentado esta declaración, le recomendamos hacerlo hoy para evitar recargos.\\n\\nQuedamos a sus órdenes.`;\n    waMsg = `🔴 *HOY VENCE — Acción inmediata*\\n\\nHola equipo de *${nombre}*,\\n\\n*HOY* es el último día para presentar:\\n\\n• *Obligación:* ${obligacion}\\n• *Período:* ${periodo}\\n\\nPresentar hoy evita recargos del SAT. Contáctenos si necesitan apoyo. 📞\\n\\n_Despacho Contable_`;\n  }\n\n  return {\n    json: {\n      ...item.json,\n      email_asunto: asunto,\n      email_mensaje: emailMsg,\n      wa_mensaje: waMsg\n    }\n  };\n});"
      },
